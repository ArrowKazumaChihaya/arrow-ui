  "props": [
   {
    "name": "palette",
    "type": "'blue' | 'green' | 'yellow' | 'pink' | 'orange' | 'teal' | 'amber'",
    "required": true,
    "description": ""
   },
   {
    "name": "as",
    "type": "string",
    "required": false,
    "description": "",
    "default": "\"div\""
   }
  ],
  "emits": [],
  "slots": [
   "default"
  ],
  "parts": [],
  "dataAr": "theme-scope"
 },
