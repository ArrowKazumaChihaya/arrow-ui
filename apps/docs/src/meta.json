[
 {
  "name": "ArUiProvider",
  "version": "1.1.0",
  "description": "アプリに1つ置く。デザインのトークンとテーマ色を配り、宣言した部品がそろっているかを確かめる。\nどのデザインを使うかは製品が起動時に決めて渡す（利用者が選ぶ仕組みは持たない）。\nscope=\"self\" にすると、html ではなくこの部品の中だけにデザインを当てる（説明の画面で2つのデザインを並べるときなど）。",
  "props": [
   {
    "name": "design",
    "type": "ArDesign",
    "required": true,
    "description": ""
   },
   {
    "name": "palette",
    "type": "'blue' | 'green' | 'yellow' | 'pink' | 'orange' | 'teal' | 'amber'",
    "required": false,
    "description": "画面全体の既定のテーマ色。ページごとの色は ArThemeScope で変える。",
    "default": "\"blue\""
   },
   {
    "name": "requires",
    "type": "ArRequirements",
    "required": false,
    "description": "製品の arrow-ui.requires.ts。渡すと起動時に確かめ、足りなければ画面を出さない。"
   },
   {
    "name": "scope",
    "type": "'document' | 'self'",
    "required": false,
    "description": "document：html 全体に当てる（製品）。self：この部品の中だけに当てる。",
    "default": "\"document\""
   }
  ],
  "emits": [],
  "slots": [
   "default"
  ],
  "parts": [
   "portal"
  ],
  "dataAr": "requirements-error"
 },
 {
  "name": "ArThemeScope",
