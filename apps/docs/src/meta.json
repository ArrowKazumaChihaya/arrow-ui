 {
  "name": "ArTimeInput",
  "version": "1.0.0",
  "description": "時刻の入力。\n- キー入力が基本：「930」「9:30」「０９３０」は 09:30 になる。↑↓で step 分ずつ動く。\n- dayShift なら枠と一体の［当日］ボタン。押すたびに［前日］と切り替わる。Tab では止まらない。\n- 値の確定は Enter・フォーカスが外れたとき・切り替えのときだけ。",
  "props": [
   {
    "name": "modelValue",
    "type": "ArTimeValue",
    "required": true,
    "description": ""
   },
   {
    "name": "dayShift",
    "type": "boolean",
    "required": false,
    "description": "枠と一体の［当日⇄前日］を出す（出勤・退勤・休憩）。シフトの開始・終了は false。",
    "default": "false"
   },
   {
    "name": "step",
    "type": "1 | 5 | 10 | 15 | 30",
    "required": false,
    "description": "↑↓キーで動かす分。",
    "default": "5"
   },
   {
    "name": "size",
    "type": "'sm' | 'md' | 'lg'",
    "required": false,
    "description": "",
    "default": "\"md\""
   },
   {
    "name": "invalid",
    "type": "boolean",
    "required": false,
    "description": "外から渡す間違いの状態（例：終了が開始より前）。",
    "default": "false"
   },
   {
    "name": "disabled",
    "type": "boolean",
    "required": false,
    "description": "",
    "default": "false"
   },
   {
    "name": "placeholder",
    "type": "string",
    "required": false,
    "description": "",
    "default": "\"--:--\""
   },
   {
    "name": "label",
    "type": "string",
    "required": false,
    "description": "読み上げ用の名前（例：「1行目の出勤」）。ArField の中なら id で結ぶので不要。"
   },
   {
    "name": "id",
    "type": "string",
    "required": false,
    "description": ""
   },
   {
    "name": "labels",
    "type": "{ same: string; prev: string; toggleHint: string; }",
    "required": false,
    "description": "",
    "default": "{ same: \"当日\", prev: \"前日\", toggleHint: \"押すと当日と前日が切り替わります\" }"
   }
  ],
  "emits": [
   {
    "name": "update:modelValue",
    "payload": "[value: ArTimeValue]",
    "description": "確定したとき（Enter・フォーカスが外れた・切り替えを押した）だけ出す。入力中には出さない。"
   },
   {
    "name": "commit",
    "payload": "[value: ArTimeValue]",
    "description": ""
   },
   {
    "name": "invalid",
    "payload": "[text: string]",
    "description": "読めない文字で確定しようとした。値は変えない。"
   }
  ],
  "slots": [],
  "parts": [
   "root",
   "day-toggle",
   "input"
  ],
  "dataAr": "time-input"
 },
 {
