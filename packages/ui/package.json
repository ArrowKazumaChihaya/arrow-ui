{
  "name": "@s_and_a/arrow-ui",
  "version": "0.2.1",
  "description": "ARROW シリーズ共通の Vue 3 デザインライブラリ（部品・契約・デザインの差し替えの仕組み）",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "design": [
        "./dist/types/design-entry.d.ts"
      ],
      "requirements": [
        "./dist/types/requirements/index.d.ts"
      ],
      "product": [
        "./dist/types/product/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./design": {
      "types": "./dist/types/design-entry.d.ts",
      "import": "./dist/design.js"
    },
    "./requirements": {
      "types": "./dist/types/requirements/index.d.ts",
      "import": "./dist/requirements.js"
    },
    "./style.css": "./dist/style.css",
    "./product": {
      "types": "./dist/types/product/index.d.ts",
      "import": "./dist/product.js"
    }
  },
  "bin": {
    "arrow-ui": "bin/arrow-ui.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@s_and_a/arrow-ui-tokens": "0.1.2",
    "jiti": "^2.6.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArrowKazumaChihaya/arrow-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://arrowkazumachihaya.github.io/arrow-ui/",
  "bugs": {
    "url": "https://github.com/ArrowKazumaChihaya/arrow-ui/issues"
  }
}
