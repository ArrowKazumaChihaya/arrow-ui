{
  "name": "@arrow/ui",
  "version": "0.1.0",
  "description": "ARROW シリーズ共通の Vue 3 デザインライブラリ（部品・契約・skin の仕組み）",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skin": {
      "types": "./dist/types/skin-entry.d.ts",
      "import": "./dist/skin.js"
    },
    "./requirements": {
      "types": "./dist/types/requirements/index.d.ts",
      "import": "./dist/requirements.js"
    },
    "./style.css": "./dist/style.css"
  },
  "bin": {
    "arrow-ui": "./bin/arrow-ui.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@arrow/ui-tokens": "0.1.0",
    "jiti": "^2.6.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}