  },
  "files": [
    "dist",
    "src/styles.css",
    "src/parts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@s_and_a/arrow-ui": "0.1.2"
  },
  "dependencies": {
    "@s_and_a/arrow-ui-tokens": "0.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArrowKazumaChihaya/arrow-ui.git",
    "directory": "packages/ui-design-classic"
  },
  "homepage": "https://arrowkazumachihaya.github.io/arrow-ui/",
