{
  "name": "@arrow/ui-design-classic",
  "version": "0.1.1",
  "description": "ARROW UI の design：classic",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/parts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@arrow/ui": "0.1.1"
  },
  "dependencies": {
    "@arrow/ui-tokens": "0.1.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
