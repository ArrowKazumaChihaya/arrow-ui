{
  "name": "@s_and_a/arrow-ui-design-classic",
  "version": "0.1.2",
  "description": "ARROW UI の design：classic",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
