{
  "name": "@s_and_a/eslint-plugin-arrow-ui",
  "version": "0.1.1",
  "description": "ARROW UI を使う製品のための ESLint ルール（宣言した部品だけを使う・並べる基礎を View で使わない）",
  "main": "./lib/index.cjs",
  "exports": {
    ".": "./lib/index.cjs"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node -e \"require('./lib/index.cjs')\""
  },
  "peerDependencies": {
    "eslint": ">=8.57.0",
    "vue-eslint-parser": ">=9.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArrowKazumaChihaya/arrow-ui.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://arrowkazumachihaya.github.io/arrow-ui/",
  "bugs": {
    "url": "https://github.com/ArrowKazumaChihaya/arrow-ui/issues"
  }
}
