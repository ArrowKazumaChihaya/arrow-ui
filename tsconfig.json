{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@arrow/ui-tokens": [
        "packages/ui-tokens/src/index.ts"
      ],
      "@arrow/ui": [
        "packages/ui/src/index.ts"
      ],
      "@arrow/ui/requirements": [
        "packages/ui/src/requirements/index.ts"
      ],
      "@arrow/ui-design-remix": [
        "packages/ui-design-remix/src/index.ts"
      ],
      "@arrow/ui-design-classic": [
        "packages/ui-design-classic/src/index.ts"
      ],
      "@arrow/ui/design": [
        "packages/ui/src/design-entry.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "apps/catalog/src/**/*",
    "env.d.ts"
  ]
}