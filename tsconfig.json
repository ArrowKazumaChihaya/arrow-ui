{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@s_and_a/arrow-ui-tokens": [
        "packages/ui-tokens/src/index.ts"
      ],
      "@s_and_a/arrow-ui": [
        "packages/ui/src/index.ts"
      ],
      "@s_and_a/arrow-ui/requirements": [
        "packages/ui/src/requirements/index.ts"
      ],
      "@s_and_a/arrow-ui-design-remix": [
        "packages/ui-design-remix/src/index.ts"
      ],
      "@s_and_a/arrow-ui-design-classic": [
        "packages/ui-design-classic/src/index.ts"
      ],
      "@s_and_a/arrow-ui/design": [
        "packages/ui/src/design-entry.ts"
      ],
      "@s_and_a/arrow-ui/product": [
        "packages/ui/src/product/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "apps/catalog/src/**/*",
    "apps/docs/src/**/*",
    "env.d.ts"
  ]
}
