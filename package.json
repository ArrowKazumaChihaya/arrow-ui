{
  "name": "arrow-ui-monorepo",
  "private": true,
  "description": "ARROW シリーズ共通の Vue 3 デザインライブラリ",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @arrow/ui-tokens && npm run build -w @arrow/ui && npm run build -w @arrow/ui-design-remix -w @arrow/ui-design-classic -w @arrow/eslint-plugin-ui",
    "typecheck": "node scripts/gen-registry.mjs --check && vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "catalog": "npm run dev -w @arrow/catalog",
    "catalog:build": "npm run build -w @arrow/catalog",
    "docs": "npm run dev -w @arrow/docs",
    "docs:build": "npm run build -w @arrow/docs",
    "test:visual": "node apps/catalog/visual.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "gen": "node scripts/gen-registry.mjs && node scripts/gen-meta.mjs",
    "release:preview": "npm pack --dry-run --json -w @arrow/ui-tokens -w @arrow/ui -w @arrow/ui-design-remix -w @arrow/ui-design-classic -w @arrow/eslint-plugin-ui"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/eslint": "^8.56.12",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^6.1.4",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.1.0"
  }
}
